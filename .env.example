# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MELHOR_ENVIO_TOKEN: Token de Acesso da Área Dev do Melhor Envio (Bearer Token)
# Obtenha em:
# - Sandbox: https://sandbox.melhorenvio.com.br/painel/gerenciar/tokens
# - Produção: https://melhorenvio.com.br/painel/gerenciar/tokens
MELHOR_ENVIO_TOKEN=

# MELHOR_ENVIO_ENV: Ambiente da API ('sandbox' para testes ou 'production' para produção)
MELHOR_ENVIO_ENV="sandbox"

# MELHOR_ENVIO_FROM_CEP: CEP de Origem da expedição da sua loja (apenas dígitos ou com hífen)
MELHOR_ENVIO_FROM_CEP="01001-000"

# MELHOR_ENVIO_EMAIL: E-mail de contato técnico enviado no header User-Agent para a API
MELHOR_ENVIO_EMAIL="contato@lavistore.com.br"

# STORE_EMAIL: E-mail do lojista que receberá as notificações automáticas de novas vendas
STORE_EMAIL="reginahelena1980@gmail.com"

# STORE_WHATSAPP: Telefone WhatsApp da loja para onde será gerado o link wa.me com os pedidos
STORE_WHATSAPP="5511987654321"

# PAGSEGURO_PAYMENT_URL: Opcional
PAGSEGURO_PAYMENT_URL=

# MERCADO PAGO - CHECKOUT TRANSPARENTE (Payment Brick)
# Obtenha suas credenciais no painel de desenvolvedores do Mercado Pago:
# https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MERCADO_PAGO_ACCESS_TOKEN=

# SMTP EMAIL CONFIGURATION (Opcional - Nodemailer):
# Configure caso queira envio real via servidor SMTP (Gmail, Hostgator, Resend, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Lavistore <pedidos@lavistore.com.br>"

