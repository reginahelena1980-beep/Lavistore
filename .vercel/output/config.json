{
  "version": 3,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/mercadopago/process_payment$",
      "dest": "/api/mercadopago/process_payment.js",
      "check": true
    },
    {
      "src": "^/api/mercadopago/payment_status(?:/([^/]+?))$",
      "dest": "/api/mercadopago/payment_status/[id].js?id=$1",
      "check": true
    },
    {
      "src": "^/api/mercadopago/payment_status/([^/]+)$",
      "dest": "/api/mercadopago/payment_status/[id]?id=$1",
      "check": true
    },
    {
      "src": "^/api(/.*)?$",
      "status": 404
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    },
    {
      "handle": "miss"
    },
    {
      "src": "^/api/(.+)(?:\\.(?:js))$",
      "dest": "/api/$1",
      "check": true
    }
  ],
  "framework": {
    "slug": "vite",
    "version": "6.4.3"
  },
  "crons": []
}
